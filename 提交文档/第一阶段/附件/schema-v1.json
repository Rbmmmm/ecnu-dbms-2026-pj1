{
  "validators": {
    "users": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "schema_version",
          "username",
          "password_hash",
          "created_at"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "schema_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "username": {
            "bsonType": "string"
          },
          "password_hash": {
            "bsonType": "string"
          },
          "created_at": {
            "bsonType": "date"
          }
        }
      }
    },
    "sessions": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "schema_version",
          "user_id",
          "token_hash",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "schema_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "user_id": {
            "bsonType": "objectId"
          },
          "token_hash": {
            "bsonType": "string"
          },
          "created_at": {
            "bsonType": "date"
          },
          "expires_at": {
            "bsonType": "date"
          }
        }
      }
    },
    "surveys": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "schema_version",
          "owner_id",
          "title",
          "description",
          "allow_anonymous",
          "allow_repeat",
          "state",
          "deadline_at",
          "revision",
          "content_version",
          "created_at",
          "updated_at",
          "published_at",
          "closed_at",
          "questions"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "schema_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "owner_id": {
            "bsonType": "objectId"
          },
          "title": {
            "bsonType": "string"
          },
          "description": {
            "bsonType": "string"
          },
          "allow_anonymous": {
            "bsonType": "bool"
          },
          "allow_repeat": {
            "bsonType": "bool"
          },
          "state": {
            "bsonType": "string",
            "enum": [
              "draft",
              "published",
              "closed"
            ]
          },
          "deadline_at": {
            "bsonType": [
              "date",
              "null"
            ]
          },
          "revision": {
            "bsonType": "int",
            "minimum": 1
          },
          "content_version": {
            "bsonType": [
              "int",
              "null"
            ],
            "enum": [
              null,
              1
            ]
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          },
          "published_at": {
            "bsonType": [
              "date",
              "null"
            ]
          },
          "closed_at": {
            "bsonType": [
              "date",
              "null"
            ]
          },
          "questions": {
            "bsonType": "array",
            "maxItems": 100,
            "items": {
              "bsonType": "object",
              "required": [
                "id",
                "kind",
                "title",
                "required",
                "validation",
                "options",
                "rules"
              ],
              "properties": {
                "id": {
                  "bsonType": "string"
                },
                "kind": {
                  "bsonType": "string",
                  "enum": [
                    "single",
                    "multiple",
                    "text",
                    "number"
                  ]
                },
                "title": {
                  "bsonType": "string"
                },
                "required": {
                  "bsonType": "bool"
                },
                "validation": {
                  "bsonType": "object"
                },
                "options": {
                  "bsonType": "array"
                },
                "rules": {
                  "bsonType": "array"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": [
          "schema_version",
          "survey_id",
          "respondent_id",
          "content_version",
          "anonymous",
          "repeat_allowed",
          "submission_key",
          "request_digest",
          "accepted_at",
          "created_at",
          "path",
          "answers"
        ],
        "properties": {
          "_id": {
            "bsonType": "objectId"
          },
          "schema_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "survey_id": {
            "bsonType": "objectId"
          },
          "respondent_id": {
            "bsonType": "objectId"
          },
          "content_version": {
            "bsonType": "int",
            "enum": [
              1
            ]
          },
          "anonymous": {
            "bsonType": "bool"
          },
          "repeat_allowed": {
            "bsonType": "bool"
          },
          "submission_key": {
            "bsonType": "string"
          },
          "request_digest": {
            "bsonType": "string"
          },
          "accepted_at": {
            "bsonType": "date"
          },
          "created_at": {
            "bsonType": "date"
          },
          "path": {
            "bsonType": "array",
            "items": {
              "bsonType": "string"
            }
          },
          "answers": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": [
                "question_id",
                "value"
              ],
              "properties": {
                "question_id": {
                  "bsonType": "string"
                },
                "value": {
                  "bsonType": [
                    "string",
                    "array",
                    "decimal"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "indexes": {
    "users": [
      {
        "unique": true,
        "name": "username_unique",
        "key": {
          "username": 1
        }
      }
    ],
    "surveys": [
      {
        "name": "owner_created",
        "key": {
          "owner_id": 1,
          "created_at": -1,
          "_id": -1
        }
      }
    ],
    "sessions": [
      {
        "unique": true,
        "name": "token_unique",
        "key": {
          "token_hash": 1
        }
      },
      {
        "expireAfterSeconds": 0,
        "name": "session_expiry",
        "key": {
          "expires_at": 1
        }
      }
    ],
    "responses": [
      {
        "unique": true,
        "name": "submission_unique",
        "key": {
          "survey_id": 1,
          "respondent_id": 1,
          "submission_key": 1
        }
      },
      {
        "unique": true,
        "partialFilterExpression": {
          "repeat_allowed": false
        },
        "name": "once_per_account",
        "key": {
          "survey_id": 1,
          "respondent_id": 1
        }
      },
      {
        "name": "survey_created",
        "key": {
          "survey_id": 1,
          "created_at": -1,
          "_id": -1
        }
      }
    ]
  }
}
