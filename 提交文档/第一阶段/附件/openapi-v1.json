  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "DeadlineChange": {
        "properties": {
          "revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Revision"
          },
          "deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "deadline_at"
        ],
        "title": "DeadlineChange"
      },
      "Draft": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title",
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "title": "Description",
            "default": ""
          },
          "allow_anonymous": {
            "type": "boolean",
            "title": "Allow Anonymous",
            "default": false
          },
          "allow_repeat": {
            "type": "boolean",
            "title": "Allow Repeat",
            "default": false
          },
          "deadline_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 1.0,
            "title": "Revision"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Questions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "questions"
        ],
        "title": "Draft"
      },
      "Evaluate": {
        "properties": {
          "content_version": {
            "type": "integer",
            "const": 1,
            "title": "Content Version"
          },
          "answers": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "maxItems": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content_version",
          "answers"
        ],
        "title": "Evaluate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginCredentials": {
        "properties": {
          "username": {
